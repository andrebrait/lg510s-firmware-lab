diff --git a/target/linux/realtek/dts/rtl9303_lianguo_lg510s-4t2xs.dts b/target/linux/realtek/dts/rtl9303_lianguo_lg510s-4t2xs.dts
new file mode 100644
index 0000000..f2b8a68
--- /dev/null
+++ b/target/linux/realtek/dts/rtl9303_lianguo_lg510s-4t2xs.dts
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Lianguo LG510S-4T2XS (also sold as Horaco ZX510S-4T2XS):
+ * RTL9303, one RTL8264B quad 10G PHY, two SFP+ cages, 128 MiB RAM, 16 MiB SPI NOR.
+ */
+/dts-v1/;
+
+#include "rtl930x.dtsi"
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	compatible = "lianguo,lg510s-4t2xs", "realtek,rtl9303-soc";
+	model = "Lianguo LG510S-4T2XS";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x8000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		label-mac-device = &ethernet0;
+		led-boot = &led_sys;
+		led-failsafe = &led_sys;
+		led-running = &led_sys;
+		led-upgrade = &led_sys;
+	};
+
+	/* SYS LED; stock blinks it in hardware until boot completes */
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinmux_disable_sys_led>;
+
+		led_sys: led-0 {
+			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		button-reset {
+			label = "reset";
+			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	/*
+	 * Stock LED setup, as programmed by U-Boot "rtk network on" and the
+	 * vendor ledConf: serial LED chain, three LEDs per port (LED2 unused),
+	 * LED1 = 10G, LED0 = lower speeds; set 1 serves the SFP+ ports.
+	 */
+	led_set {
+		compatible = "realtek,rtl9300-leds";
+		active-low;
+		realtek,led-mode = <RTL93XX_LED_MODE_SERIAL>;
+
+		led_set0 = <
+			(RTL93XX_LED_SET_NONE)
+			(RTL93XX_LED_SET_10G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
+			(RTL93XX_LED_SET_5G | RTL93XX_LED_SET_2P5G | RTL93XX_LED_SET_1G |
+			 RTL93XX_LED_SET_100M | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
+		>;
+
+		led_set1 = <
+			(RTL93XX_LED_SET_NONE)
+			(RTL93XX_LED_SET_10G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
+			(RTL93XX_LED_SET_2P5G | RTL93XX_LED_SET_1G | RTL93XX_LED_SET_100M |
+			 RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
+		>;
+
+		/* stock keeps the unpopulated port 24 in the serial LED chain */
+		realtek,led-set0-force-port-mask = <0x01000000>;
+	};
+
+	/* Front-panel port 5 */
+	sfp0: sfp-p5 {
+		compatible = "sff,sfp";
+		i2c-bus = <&i2c_sfp0>;
+		mod-def0-gpio = <&gpio0 14 GPIO_ACTIVE_LOW>;
+		los-gpio = <&gpio0 13 GPIO_ACTIVE_HIGH>;
+		tx-disable-gpio = <&gpio0 15 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <2000>;
+	};
+
+	/* Front-panel port 6; GPIO 18 shares its pin with the USB LED */
+	sfp1: sfp-p6 {
+		compatible = "sff,sfp";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinmux_disable_usb_led>;
+		i2c-bus = <&i2c_sfp1>;
+		mod-def0-gpio = <&gpio0 17 GPIO_ACTIVE_LOW>;
+		los-gpio = <&gpio0 16 GPIO_ACTIVE_HIGH>;
+		tx-disable-gpio = <&gpio0 18 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <2000>;
+	};
+};
+
+/* SCL on GPIO 8; SDA 0/1 on GPIO 9/10 */
+&i2c_mst1 {
+	status = "okay";
+
+	i2c_sfp0: i2c@0 { reg = <0>; };
+	i2c_sfp1: i2c@1 { reg = <1>; };
+};
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+
+		/* Stock layout; only the runtime image ("firmware") is writable. */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "loader";
+				reg = <0x0 0xe0000>;
+				read-only;
+			};
+
+			partition@e0000 {
+				label = "bdinfo";
+				reg = <0xe0000 0x10000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "u-boot,env";
+
+					macaddr_ubootenv_ethaddr: ethaddr {
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@f0000 {
+				label = "sysinfo";
+				reg = <0xf0000 0x10000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "jffs2-cfg";
+				reg = <0x100000 0x100000>;
+				read-only;
+			};
+
+			partition@200000 {
+				label = "jffs2-log";
+				reg = <0x200000 0x100000>;
+				read-only;
+			};
+
+			partition@300000 {
+				label = "firmware";
+				reg = <0x300000 0xc00000>;
+				compatible = "openwrt,uimage", "denx,uimage";
+				openwrt,ih-magic = <0x83800000>;
+			};
+
+			partition@f00000 {
+				label = "oeminfo";
+				reg = <0xf00000 0x100000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&mdio_bus0 {
+	phy0: ethernet-phy@0 {
+		reg = <0>;
+		compatible = "ethernet-phy-ieee802.3-c45";
+	};
+
+	phy8: ethernet-phy@1 {
+		reg = <1>;
+		compatible = "ethernet-phy-ieee802.3-c45";
+	};
+
+	phy16: ethernet-phy@2 {
+		reg = <2>;
+		compatible = "ethernet-phy-ieee802.3-c45";
+	};
+
+	phy20: ethernet-phy@3 {
+		reg = <3>;
+		compatible = "ethernet-phy-ieee802.3-c45";
+	};
+};
+
+&ethernet0 {
+	nvmem-cells = <&macaddr_ubootenv_ethaddr 0>;
+	nvmem-cell-names = "mac-address";
+};
+
+&switch0 {
+	ethernet-ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* RJ45 ports, lan1-4 */
+		SWITCH_PORT_SDS(0, 1, 2, 0, usxgmii)
+		SWITCH_PORT_SDS(8, 2, 3, 0, usxgmii)
+		SWITCH_PORT_SDS(16, 3, 4, 0, usxgmii)
+		SWITCH_PORT_SDS(20, 4, 5, 0, usxgmii)
+
+		/* SFP+ ports, lan5-6 */
+		port25: port@25 {
+			reg = <25>;
+			label = "lan5";
+			pcs-handle = <&serdes7 0>;
+			phy-mode = "1000base-x";
+			sfp = <&sfp0>;
+			managed = "in-band-status";
+			led-set = <1>;
+		};
+
+		port26: port@26 {
+			reg = <26>;
+			label = "lan6";
+			pcs-handle = <&serdes8 0>;
+			phy-mode = "1000base-x";
+			sfp = <&sfp1>;
+			managed = "in-band-status";
+			led-set = <1>;
+		};
+
+		/* CPU port */
+		port@28 {
+			ethernet = <&ethernet0>;
+			reg = <28>;
+			phy-mode = "internal";
+
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+	};
+};
