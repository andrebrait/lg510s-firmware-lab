diff --git a/target/linux/realtek/base-files/etc/uci-defaults/05_lg510s_port_defaults b/target/linux/realtek/base-files/etc/uci-defaults/05_lg510s_port_defaults
new file mode 100644
index 0000000..e5b7e4e
--- /dev/null
+++ b/target/linux/realtek/base-files/etc/uci-defaults/05_lg510s_port_defaults
@@ -0,0 +1,20 @@
+. /lib/functions.sh
+
+# Advertise EEE and flow control (pause) on the RTL8264B copper ports; both take effect
+# only if the link partner agrees. The SFP+ ports (10GBASE-R) cannot negotiate either.
+# uci-defaults also run after a sysupgrade that keeps settings: leave existing port sections alone.
+case "$(board_name)" in
+lianguo,lg510s-4t2xs)
+	for port in lan1 lan2 lan3 lan4; do
+		uci -q show network | grep -q "^network\.[^.]*\.name='$port'$" && continue
+		s=$(uci add network device)
+		uci set network.$s.name="$port"
+		uci set network.$s.eee='1'
+		# pause, not rxpause/txpause: netifd forces pause (no autonegotiation) for those.
+		uci set network.$s.pause='1'
+	done
+	uci commit network
+	;;
+esac
+
+exit 0
diff --git a/target/linux/realtek/base-files/etc/uci-defaults/06_lg510s_lldpd b/target/linux/realtek/base-files/etc/uci-defaults/06_lg510s_lldpd
new file mode 100644
index 0000000..dc963b2
--- /dev/null
+++ b/target/linux/realtek/base-files/etc/uci-defaults/06_lg510s_lldpd
@@ -0,0 +1,27 @@
+. /lib/functions.sh
+
+# lldpd ships in the image but stays off until the user enables it. luci-app-lldpd
+# keeps that choice in lldpd.config.enabled, which survives a sysupgrade.
+case "$(board_name)" in
+lianguo,lg510s-4t2xs)
+	[ -x /etc/init.d/lldpd ] || exit 0
+	enabled=$(uci -q get lldpd.config.enabled)
+	if [ -z "$enabled" ]; then
+		enabled=0
+		uci set lldpd.config.enabled="$enabled"
+	fi
+	# Describe the switch by its model, as stock does, instead of "OpenWrt ... @ hostname".
+	# Set only while unset, so a description chosen in LuCI survives updates.
+	model=$(cat /tmp/sysinfo/model 2>/dev/null)
+	[ -n "$model" ] && [ -z "$(uci -q get lldpd.config.lldp_description)" ] &&
+		uci set lldpd.config.lldp_description="${model#* }"
+	uci commit lldpd
+	if [ "$enabled" = 1 ]; then
+		/etc/init.d/lldpd enable
+	else
+		/etc/init.d/lldpd disable
+	fi
+	;;
+esac
+
+exit 0
diff --git a/target/linux/realtek/base-files/etc/uci-defaults/07_lg510s_snmpd b/target/linux/realtek/base-files/etc/uci-defaults/07_lg510s_snmpd
new file mode 100644
index 0000000..64e29f5
--- /dev/null
+++ b/target/linux/realtek/base-files/etc/uci-defaults/07_lg510s_snmpd
@@ -0,0 +1,18 @@
+. /lib/functions.sh
+
+# snmpd ships in the image but stays off until the user enables it. Its package
+# default says enabled '1', so a marker kept across sysupgrade records that the
+# default was already turned off once and leaves later user choices alone.
+MARKER=/etc/lg510s/snmpd-default-off
+
+case "$(board_name)" in
+lianguo,lg510s-4t2xs)
+	[ -f /etc/config/snmpd ] && [ ! -f "$MARKER" ] || exit 0
+	uci set snmpd.general.enabled='0'
+	uci commit snmpd
+	mkdir -p "${MARKER%/*}"
+	touch "$MARKER"
+	;;
+esac
+
+exit 0
diff --git a/target/linux/realtek/base-files/etc/uci-defaults/08_lg510s_https b/target/linux/realtek/base-files/etc/uci-defaults/08_lg510s_https
new file mode 100644
index 0000000..08ff39b
--- /dev/null
+++ b/target/linux/realtek/base-files/etc/uci-defaults/08_lg510s_https
@@ -0,0 +1,17 @@
+. /lib/functions.sh
+
+# Redirect HTTP to HTTPS by default. A marker kept across sysupgrade records that
+# the default was applied once, so a user who turns the redirect off keeps that.
+MARKER=/etc/lg510s/https-redirect-default
+
+case "$(board_name)" in
+lianguo,lg510s-4t2xs)
+	[ -f /etc/config/uhttpd ] && [ ! -f "$MARKER" ] || exit 0
+	uci set uhttpd.main.redirect_https='1'
+	uci commit uhttpd
+	mkdir -p "${MARKER%/*}"
+	touch "$MARKER"
+	;;
+esac
+
+exit 0
diff --git a/target/linux/realtek/base-files/etc/uci-defaults/09_lg510s_mgmt b/target/linux/realtek/base-files/etc/uci-defaults/09_lg510s_mgmt
new file mode 100644
index 0000000..952ca50
--- /dev/null
+++ b/target/linux/realtek/base-files/etc/uci-defaults/09_lg510s_mgmt
@@ -0,0 +1,39 @@
+. /lib/functions.sh
+
+# Manage the switch over DHCP without IPv6, as stock switches do. Only OpenWrt's
+# untouched static default is converted, once; the marker survives sysupgrade.
+# /etc/udhcpc.user.d/lg510s-fallback adds 192.168.1.1/24 while no lease is held.
+MARKER=/etc/lg510s/mgmt-default
+
+case "$(board_name)" in
+lianguo,lg510s-4t2xs)
+	[ -f "$MARKER" ] && exit 0
+	mkdir -p "${MARKER%/*}"
+	touch "$MARKER"
+
+	# config_generate writes 192.168.1.1/24; older releases used ipaddr plus netmask
+	[ "$(uci -q get network.lan.proto)" = static ] || exit 0
+	case "$(uci -q get network.lan.ipaddr)" in 192.168.1.1|192.168.1.1/24) ;; *) exit 0 ;; esac
+	[ -z "$(uci -q get network.lan.gateway)" ] || exit 0
+
+	# retry: udhcpc only reports leasefail, which triggers the fallback, when retries are limited
+	uci -q batch <<-EOF
+		set network.lan.proto='dhcp'
+		set network.lan.retry='3'
+		delete network.lan.ipaddr
+		delete network.lan.netmask
+		delete network.lan.ip6assign
+		delete network.globals.ula_prefix
+	EOF
+
+	# ipv6 '0' is the device option behind LuCI's "Enable IPv6" checkbox. Only the lan
+	# device needs it: the bridge itself has no untagged VLAN, eth0 is the CPU conduit.
+	dev=$(uci -q get network.lan.device)
+	s=$(uci -q show network | sed -n "s/^network\.\([^.]*\)\.name='$dev'$/\1/p")
+	[ -n "$s" ] || { s=$(uci add network device); uci set network.$s.name="$dev"; }
+	uci set network.$s.ipv6='0'
+	uci commit network
+	;;
+esac
+
+exit 0
diff --git a/target/linux/realtek/base-files/etc/udhcpc.user.d/lg510s-fallback b/target/linux/realtek/base-files/etc/udhcpc.user.d/lg510s-fallback
new file mode 100644
index 0000000..2f66ac2
--- /dev/null
+++ b/target/linux/realtek/base-files/etc/udhcpc.user.d/lg510s-fallback
@@ -0,0 +1,7 @@
+# Sourced by /lib/netifd/dhcp.script with the udhcpc event in $1.
+# While lan has no DHCP lease, give it 192.168.1.1/24; the next lease replaces it.
+[ "$(board_name)" = lianguo,lg510s-4t2xs ] && [ "$INTERFACE" = lan ] && [ "$1" = leasefail ] || exit 0
+
+proto_init_update "*" 1
+proto_add_ipv4_address 192.168.1.1 24
+proto_send_update "$INTERFACE"
diff --git a/target/linux/realtek/base-files/lib/upgrade/keep.d/lg510s b/target/linux/realtek/base-files/lib/upgrade/keep.d/lg510s
new file mode 100644
